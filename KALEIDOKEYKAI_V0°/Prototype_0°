import numpy as np
import matplotlib.pyplot as plt
from scipy.fft import fft, fftfreq
from scipy.cluster.vq import kmeans, vq
import pandas as pd
import seaborn as sns
import multiprocessing as mp
import time

# Constants
PHI = (1 + np.sqrt(5)) / 2  # Golden Ratio ≈ 1.618
FIG_RATIO = PHI

# Perez Projection (@JCPEREZCODEX)
def get_proj_factor(use_perez=True):
    phi = 1 / PHI
    phi_squared = 1 / (PHI ** 2)  # φ² ≈ 0.381966
    if use_perez:
        factor = 4 * np.pi * phi_squared  # ≈ 4.796
        return 1 - factor  # ≈ -3.796
    factor = 4 * np.pi * (1 / PHI)  # ≈ 7.767
    return 1 - factor  # ≈ -6.767

# QUIC Simulation: cBioPortal-like Ingestion
def quic_ingest(study_id='brca_tcga_pan_can_atlas_2018', genes_subset=5000):
    start = time.time()
    n_genes, n_samples = genes_subset, 200
    np.random.seed(42)
    expression = np.random.normal(0, 1, (n_genes, n_samples))  # Z-scores
    subtypes = np.random.choice([0, 1, 2], n_samples, p=[0.55, 0.25, 0.2])
    for i in range(n_genes):
        cycle = 0.3 * np.sin(2 * np.pi * (1/20) * np.arange(n_samples))
        subtype_eff = subtypes * 0.5
        expression[i] += cycle + subtype_eff
    gradient = np.diff(expression, axis=1, prepend=expression[:, [0]])
    data = np.stack((expression, gradient), axis=-1)
    t = np.arange(n_samples)
    latency = time.time() - start
    print(f"QUIC: Fetched {n_genes} genes x {n_samples} samples in {latency:.3f}s")
    return data, t, latency

# Emulate Bioconductor Structure
def emulate_bioconductor_structure(data, t):
    index = pd.MultiIndex.from_product([['RNA'], range(data.shape[0])], names=['Assay', 'Gene'])
    columns = pd.MultiIndex.from_product([['Expression'], t], names=['Type', 'Sample'])
    df = pd.DataFrame(data[:, :, 0], index=index, columns=columns)
    print("Bioconductor: MultiAssay-like structure")
    return df

# Kyber Parallel
def kyber_parallel(data, t, fs=1, n_cores=mp.cpu_count()):
    def process_torque(d):
        centroids, _ = kmeans(d.reshape(-1, d.shape[-1]), 3)
        labels, _ = vq(d.reshape(-1, d.shape[-1]), centroids)
        torque_score = np.var(labels)
        return labels[:len(d)], torque_score
    
    def process_perez(d):
        N = d.shape[1]
        yf = fft(d[0, :, 0])
        xf = fftfreq(N, 1/fs)[:N//2]
        dominant_freq = xf[np.argmax(np.abs(yf[:N//2]))]
        proj_factor = get_proj_factor(use_perez=True)
        projected = proj_factor * d
        return dominant_freq, projected, proj_factor
    
    chunks = np.array_split(data, n_cores, axis=0)
    with mp.Pool(n_cores) as pool:
        torque_results = pool.map(process_torque, chunks)
        perez_results = pool.map(process_perez, chunks)
    
    all_labels = np.concatenate([lbl for lbl, _ in torque_results])
    avg_torque = np.mean([t for _, t in torque_results])
    freqs = [f for f, _, _ in perez_results]
    dominant_freq = np.mean(freqs)
    projected_data = np.mean([p for _, p, _ in perez_results], axis=0)
    
    print(f"Kyber: Freq {dominant_freq:.3f}, Torque {avg_torque:.3f}")
    return all_labels, projected_data, dominant_freq

# NSA/MoBA Refine
def nsamba_refine(data, labels, projected, dominant_freq, top_k=0.2):
    n_genes, n_samples, _ = data.shape
    variance = np.var(projected[:, :, 0], axis=1)
    thresh = np.percentile(variance, 100 * (1 - top_k))
    sparse_mask = variance > thresh
    sparse_data = projected[sparse_mask]
    
    block_sizes = [100, 500, 1000]
    attention_weights = np.zeros((sparse_data.shape[0], len(block_sizes)))
    freq_weight = np.clip(dominant_freq, 0.01, 0.1)
    for i, block_size in enumerate(block_sizes):
        n_blocks = max(1, sparse_data.shape[0] // block_size)
        block_var = []
        for j in range(n_blocks):
            start = j * block_size
            end = min((j+1) * block_size, sparse_data.shape[0])
            block = sparse_data[:, start:end, 0]
            block_var.append(np.var(block) if block.size > 0 else 0)
        block_var = np.array(block_var)
        block_weights = np.exp(block_var / (np.max(block_var + 1e-10) * freq_weight))
        block_weights /= block_weights.sum() + 1e-10
        for j in range(n_blocks):
            start = j * block_size
            end = min((j+1) * block_size, sparse_data.shape[0])
            attention_weights[start:end, i] = block_weights[j] / (end - start)
    
    scale_weights = np.array([1.0, 0.7, 0.3]) / np.sum([1.0, 0.7, 0.3])
    mixed_attention = np.sum(attention_weights * scale_weights[np.newaxis, :], axis=1)
    mixed_attention /= mixed_attention.sum() + 1e-10
    refined_data = sparse_data[:, :, 0] * mixed_attention[:, np.newaxis]
    
    print(f"NSA/MoBA: Refined {len(refined_data)}/{n_genes} genes")
    return refined_data, labels[sparse_mask], mixed_attention, block_sizes

# Visualization
def visualize_results(t, data, labels, projected, refined, dom_freq, proj_factor, attention, block_sizes):
    fig = plt.figure(figsize=(12, 12 / FIG_RATIO))
    
    ax1 = plt.subplot(2, 2, 1)
    sns.heatmap(data[:100, :, 0].T, cmap='viridis', ax=ax1)
    ax1.set_title('Expression Heatmap + Clusters')
    
    ax2 = plt.subplot(2, 2, 2)
    plt.scatter(data[0, :, 0], data[0, :, 1], c='blue', label='Original')
    plt.scatter(projected[0, :, 0], projected[0, :, 1], c='orange', label='Projected')
    plt.title(f'Perez Formula Projection (Cycle: {1/dom_freq:.1f}, Factor: {proj_factor:.3f})')
    plt.legend()
    
    ax3 = plt.subplot(2, 2, 3)
    plt.plot(t, data[0, :, 0], label='Original Expr')
    plt.plot(t, projected[0, :, 0], label='Projected Expr')
    plt.title('Harmonic Transformation')
    plt.legend()
    
    ax4 = plt.subplot(2, 2, 4)
    sns.heatmap(attention.T, cmap='viridis', ax=ax4)
    ax4.set_yticklabels([f'{s} genes' for s in block_sizes], rotation=0)
    ax4.set_title('MoBA: Hierarchical Attention')
    
    plt.tight_layout()
    plt.savefig('kaleidokeykai_perez_formula.png', dpi=300, bbox_inches='tight')
    plt.close()

# Main
if __name__ == '__main__':
    print("=== KaleidoKeyKai: Cancer Genomics with Perez Formula (@JCPEREZCODEX) ===\nPhilosophy: Knowledge is an Arrow → CORE of the Mandala is its Target")
    
    # QUIC
    data, t, latency = quic_ingest()
    
    # Bioconductor Structure
    df = emulate_bioconductor_structure(data, t)
    
    # Kyber
    labels, projected, dom_freq = kyber_parallel(data, t)
    
    # NSA/MoBA
    refined, r_labels, attention, block_sizes = nsamba_refine(data, labels, projected, dom_freq)
    
    # Visualize
    visualize_results(t, data, labels, projected, refined, dom_freq, get_proj_factor(use_perez=True), attention, block_sizes)
    
    print("\nTest complete! PNG saved. Metrics reported.")

