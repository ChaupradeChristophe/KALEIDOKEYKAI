    assignments = np.repeat([0, 1, 2], n_samples//3)
    noise = np.random.randn(n_samples, 2) * 0.5
    clustered = noise + cluster_means[assignments]
    data = np.column_stack((signal + clustered[:, 0], clustered[:, 1]))  # 2D for viz
    return data

