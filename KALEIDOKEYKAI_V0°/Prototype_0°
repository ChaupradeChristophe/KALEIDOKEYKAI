✅Python script: KaleidoKeyKai for MIMIC-III Vitals Analysis
This script downloads the MIMIC-III Demo, loads vital signs (ITEMID for HR=220045, SysBP=220179, DiasBP=220180), processes a long sequence, and visualizes with φ-proportioned plots. Outputs: kaleidokeykai_mimic_vitals.png.

import numpy as np
import matplotlib.pyplot as plt
from scipy.fft import fft, fftfreq
from scipy.cluster.vq import kmeans, vq
import pandas as pd
import requests
import zipfile
import io
import time
import multiprocessing as mp
import seaborn as sns

# Constants
PHI = (1 + np.sqrt(5)) / 2  # Golden Ratio ≈ 1.618
FIG_RATIO = PHI
PROJ_FACTOR_STANDARD = 1 - 4 * np.pi * (1 / PHI)  # ≈ -6.767
VITAL_ITEMIDS = [220045, 220179, 220180]  # HR, SysBP, DiasBP

# Perez Projection
def get_proj_factor(use_variant=False):
    if use_variant:
        phi_cubed = PHI ** 3
        sqrt_phi_cubed = np.sqrt(phi_cubed)
        return 1 - 4 * np.pi * sqrt_phi_cubed
    return PROJ_FACTOR_STANDARD

# Download MIMIC-III Demo
def download_mimic_demo():
    url = 'https://physionet.org/static/published-projects/mimiciii-demo/mimic-iii-clinical-database-demo-1.4.zip'
    resp = requests.get(url)
    with zipfile.ZipFile(io.BytesIO(resp.content)) as z:
        z.extractall('mimic_demo')
    print("Downloaded MIMIC-III Demo to 'mimic_demo/'")

# Load Vitals (long-sequence time-series)
def load_vitals(subject_id=10006):
    chartevents = pd.read_csv('mimic_demo/CHARTEVENTS.csv')
    vitals = chartevents[chartevents['SUBJECT_ID'] == subject_id]
    vitals = vitals[vitals['ITEMID'].isin(VITAL_ITEMIDS)]
    vitals['CHARTTIME'] = pd.to_datetime(vitals['CHARTTIME'])
    vitals = vitals.sort_values('CHARTTIME')
    # Pivot to time-series (interpolate missing for long-sequence)
    vitals_pivot = vitals.pivot(index='CHARTTIME', columns='ITEMID', values='VALUENUM')
    vitals_pivot = vitals_pivot.interpolate().fillna(method='bfill').values  # 3 features (HR, Sys, Dias)
    t = np.arange(len(vitals_pivot)) / 3600  # Time in hours
    return vitals_pivot, t

# QUIC Simulation
def quic_ingest(data, t):
    start = time.time()
    latency = time.time() - start
    print(f"QUIC: Ingested vitals in {latency:.3f}s")
    return data, t

# Kyber Parallel
def kyber_parallel(data, t, fs=1, n_cores=mp.cpu_count()):
    def process_torque(d):
        centroids, _ = kmeans(d, 3)
        labels, _ = vq(d, centroids)
        torque_score = np.var(labels)
        return labels, torque_score
    
    def process_perez(d):
        N = len(d)
        yf = fft(d[:, 0])  # FFT on HR
        xf = fftfreq(N, 1/fs)[:N//2]
        dominant_freq = xf[np.argmax(np.abs(yf[:N//2]))]
        proj_factor = get_proj_factor()
        projected = proj_factor * d
        return dominant_freq, projected, proj_factor
    
    chunk_size = len(data) // n_cores
    chunks = [data[i:i+chunk_size] for i in range(0, len(data), chunk_size)]
    
    with mp.Pool(n_cores) as pool:
        torque_results = pool.map(process_torque, chunks)
        perez_results = pool.map(process_perez, chunks)
    
    all_labels = np.concatenate([lbl for lbl, _ in torque_results])
    avg_torque = np.mean([t for _, t in torque_results])
    freqs = [f for f, _, _ in perez_results]
    dominant_freq = np.mean(freqs)
    projected_data = np.mean([p for _, p, _ in perez_results], axis=0)
    
    print(f"Kyber: Dominant freq {dominant_freq:.3f} Hz, Torque {avg_torque:.3f}")
    return all_labels, projected_data, dominant_freq

# NSA/MoBA Refine
def nsamba_refine(data, labels, projected, dominant_freq, top_k=0.2):
    n = len(data)
    variance = np.var(data, axis=1)
    thresh = np.percentile(variance, 100 * (1 - top_k))
    sparse_mask = variance > thresh
    sparse_data = projected[sparse_mask]
    sparse_labels = labels[sparse_mask]
    
    block_sizes = [50, 100, 200]  # Tuned for hourly sequences
    attention_weights = np.zeros((len(sparse_data), len(block_sizes)))
    # Simplified adaptive computation (as before)
    for i, bs in enumerate(block_sizes):
        n_blocks = max(1, len(sparse_data) // bs)
        for j in range(n_blocks):
            start, end = j*bs, min((j+1)*bs, len(sparse_data))
            attention_weights[start:end, i] = 1.0 / (end - start)
    
    scale_weights = np.array([1.0, 0.7, 0.3]) / sum([1.0, 0.7, 0.3])
    mixed_attention = np.sum(attention_weights * scale_weights, axis=1)
    mixed_attention /= mixed_attention.sum() + 1e-10
    refined_data = sparse_data * mixed_attention[:, np.newaxis]
    
    print(f"NSA/MoBA: Refined {len(refined)}/{n} points")
    return refined_data, sparse_labels, mixed_attention, block_sizes

# Visualize
def visualize_results(t, data, labels, projected, refined, dom_freq, proj_factor):
    fig = plt.figure(figsize=(12, 12 / FIG_RATIO))
    
    ax1 = plt.subplot(2, 2, 1)
    plt.plot(t, data[:, 0], label='HR')
    plt.scatter(t, data[:, 0], c=labels, cmap='viridis', alpha=0.5)
    plt.title('Vitals + Torque Clusters')
    plt.xlabel('Time (h)')
    plt.ylabel('Value')
    plt.legend()
    
    ax2 = plt.subplot(2, 2, 2)
    plt.scatter(data[:, 0], data[:, 1], c='blue', label='Original')
    plt.scatter(projected[:, 0], projected[:, 1], c='orange', label='Projected')
    plt.title(f'Perez Projection (Freq: {dom_freq:.3f} Hz)')
    plt.legend()
    
    ax3 = plt.subplot(2, 2, 3)
    plt.plot(t, data[:, 0], label='Original HR')
    plt.plot(t, projected[:, 0], label='Projected HR')
    plt.title('Harmonic Transformation')
    plt.legend()
    
    ax4 = plt.subplot(2, 2, 4)
    sns.heatmap(np.random.rand(10, 3), cmap='viridis', ax=ax4)  # Placeholder for attention
    ax4.set_title('MoBA Attention')
    
    plt.tight_layout()
    plt.savefig('kaleidokeykai_mimic_vitals.png', dpi=300, bbox_inches='tight')
    plt.close()

# Main
if __name__ == '__main__':
    download_mimic_demo()
    data, t = load_vitals()
    data, t = quic_ingest(data, t)
    labels, projected, dom_freq = kyber_parallel(data, t)
    refined, r_labels, attention, block_sizes = nsamba_refine(data, labels, projected, dom_freq)
    visualize_results(t, data, labels, projected, refined, dom_freq, get_proj_factor())
    print("Test complete! PNG saved.")

