import numpy as np
import matplotlib.pyplot as plt
from scipy.fft import fft, fftfreq
from scipy.cluster.vq import kmeans, vq
import multiprocessing as mp
import seaborn as sns

# Constants
PHI = (1 + np.sqrt(5)) / 2  # Golden Ratio ≈ 1.618
FIG_RATIO = PHI
PROJ_FACTOR_STANDARD = 1 - 4 * np.pi * (1 / PHI)  # ≈ -6.767

# Perez Projection
def get_proj_factor(use_variant=False):
    if use_variant:
        phi_cubed = PHI ** 3
        sqrt_phi_cubed = np.sqrt(phi_cubed)
        return 1 - 4 * np.pi * sqrt_phi_cubed  # ≈ -24.86
    return PROJ_FACTOR_STANDARD

# QUIC: Low-latency ingestion
def quic_ingest(data_gen_func, *args):
    start = time.time()
    data = data_gen_func(*args)
    latency = time.time() - start
    print(f"QUIC: Ingested ECG in {latency:.3f}s")
    return data

# Synthetic ECG Generator (based on McSharry et al.)
def generate_ecg(n_samples=2500, fs=250, hr=80, anomaly=False):
    t = np.linspace(0, n_samples/fs, n_samples)
    rr_interval = 60 / hr  # Seconds per beat
    n_beats = int(n_samples / fs / rr_interval)
    
    # ECG components: P, QRS, T waves
    signal = np.zeros(n_samples)
    for i in range(n_beats):
        t_beat = t - i * rr_interval
        # P wave
        signal += 0.1 * np.exp(-((t_beat - 0.05)**2) / (2 * 0.03**2))
        # QRS (narrow, high amplitude)
        signal += 1.0 * np.exp(-((t_beat - 0.1)**2) / (2 * 0.01**2))
        # T wave
        signal += 0.2 * np.exp(-((t_beat - 0.2)**2) / (2 * 0.05**2))
    
    # Add anomaly (ectopic beat) at ~60% of signal
    if anomaly:
        t_anomaly = t - 0.6 * t[-1]
        signal += 1.5 * np.exp(-((t_anomaly - 0.1)**2) / (2 * 0.015**2))
    
    # Add noise
    signal += np.random.normal(0, 0.05, n_samples)
    
    # Convert to 2D for clustering (signal + derivative for feature richness)
    derivative = np.diff(signal, prepend=signal[0])
    data = np.column_stack((signal, derivative))
    return data, t

# Kyber: Parallel processing
def kyber_parallel(data, t, fs=250, n_cores=mp.cpu_count()):
    def process_torque(d):
        centroids, _ = kmeans(d, 3)  # 3 clusters: normal, QRS, anomaly
        labels, _ = vq(d, centroids)
        torque_score = np.var(labels)
        return labels, torque_score
    
    def process_perez(d):
        N = len(d)
        yf = fft(d[:, 0])  # FFT on signal
        xf = fftfreq(N, 1/fs)[:N//2]
        dominant_freq = xf[np.argmax(np.abs(yf[:N//2]))]
        proj_factor = get_proj_factor(use_variant=False)
        projected = proj_factor * d
        return dominant_freq, projected, proj_factor
    
    chunk_size = len(data) // n_cores
    chunks = [data[i:i+chunk_size] for i in range(0, len(data), chunk_size)]
    
    with mp.Pool(n_cores) as pool:
        torque_results = pool.map(process_torque, chunks)
        perez_results = pool.map(process_perez, chunks)
    
    all_labels = np.concatenate([lbl for lbl, _ in torque_results])
    avg_torque = np.mean([t for _, t in torque_results])
    freqs = [f for f, _, _ in perez_results]
    dominant_freq = np.mean(freqs)
    projected_data = np.mean([p for _, p, _ in perez_results], axis=0)
    
    print(f"Kyber: Parallel ops complete. Heart rate: {dominant_freq*60:.1f} bpm, Torque: {avg_torque:.3f}")
    return all_labels, projected_data, dominant_freq

# NSA/MoBA: Enhanced attention
def nsamba_refine(data, labels, projected, dominant_freq, fs=250, top_k=0.2):
    n = len(data)
    # NSA: Sparse attention (top-k% high-variance, e.g., QRS peaks)
    variance = np.var(data, axis=1)
    thresh = np.percentile(variance, 100 * (1 - top_k))
    sparse_mask = variance > thresh
    sparse_data = projected[sparse_mask]
    sparse_labels = labels[sparse_mask]
    n_sparse = len(sparse_data)
    
    # MoBA: Hierarchical blocks for ECG (25, 50, 100 samples ≈ 0.1s, 0.2s, 0.4s)
    block_sizes = [int(0.1*fs), int(0.2*fs), int(0.4*fs)]
    attention_weights = np.zeros((n_sparse, len(block_sizes)))
    
    # Adaptive weights based on heart rate
    freq_weight = np.clip(dominant_freq, 0.5, 2.0)
    for i, block_size in enumerate(block_sizes):
        n_blocks = max(1, n_sparse // block_size)
        block_var = []
        for j in range(n_blocks):
            start = j * block_size
            end = min((j+1) * block_size, n_sparse)
            block = sparse_data[start:end]
            block_var.append(np.var(block) if len(block) > 1 else 0)
        
        block_var = np.array(block_var)
        block_weights = np.exp(block_var / (np.max(block_var + 1e-10) * freq_weight))
        block_weights /= block_weights.sum() + 1e-10
        
        for j in range(n_blocks):
            start = j * block_size
            end = min((j+1) * block_size, n_sparse)
            attention_weights[start:end, i] = block_weights[j] / (end - start)
    
    scale_weights = np.array([1.0, 0.7, 0.3]) / np.sum([1.0, 0.7, 0.3])
    mixed_attention = np.sum(attention_weights * scale_weights[np.newaxis, :], axis=1)
    mixed_attention /= mixed_attention.sum() + 1e-10
    refined_data = sparse_data * mixed_attention[:, np.newaxis]
    
    print(f"NSA/MoBA: Refined {n_sparse}/{n} points. Blocks: {block_sizes}")
    return refined_data, sparse_labels, mixed_attention, block_sizes

# Visualization
def visualize_results(t, original, labels, projected, refined, dominant_freq, proj_factor, attention_weights, block_sizes):
    fig = plt.figure(figsize=(12, 12 / FIG_RATIO))
    
