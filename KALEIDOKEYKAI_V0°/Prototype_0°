This script generates synthetic TCGA-BRCA-like RNA-seq data, applies the pipeline, and visualizes results. Outputs: kaleidokeykai_cancer_genomics.png.

import numpy as np
import matplotlib.pyplot as plt
from scipy.fft import fft, fftfreq
from scipy.cluster.vq import kmeans, vq
import seaborn as sns
import multiprocessing as mp
import time

# Constants
PHI = (1 + np.sqrt(5)) / 2  # Golden Ratio ≈ 1.618
FIG_RATIO = PHI
PROJ_FACTOR_STANDARD = 1 - 4 * np.pi * (1 / PHI)  # ≈ -6.767

# Perez Projection
def get_proj_factor(use_variant=False):
    if use_variant:
        phi_cubed = PHI ** 3
        sqrt_phi_cubed = np.sqrt(phi_cubed)
        return 1 - 4 * np.pi * sqrt_phi_cubed
    return PROJ_FACTOR_STANDARD

# QUIC Simulation: Low-latency ingestion
def quic_ingest(data, t):
    start = time.time()
    latency = time.time() - start
    print(f"QUIC: Ingested genomic data in {latency:.3f}s")
    return data, t, latency

# Synthetic TCGA-BRCA RNA-seq Data
def generate_cancer_data(n_genes=10000, n_samples=100):
    t = np.arange(n_samples)
    expression = np.zeros((n_samples, n_genes))
    
    # 3 subtypes (Luminal A, Luminal B, Basal-like)
    subtype_labels = np.random.choice([0, 1, 2], size=n_samples, p=[0.5, 0.3, 0.2])
    for i in range(n_genes):
        # Baseline expression
        baseline = np.random.normal(5, 1, n_samples)
        # Cyclic pattern (e.g., circadian, ~15 samples/cycle)
        cycle = 0.5 * np.sin(2 * np.pi * (1/15) * t)
        # Subtype-specific expression
        subtype_effect = np.where(subtype_labels == 0, 1, np.where(subtype_labels == 1, 2, 3))
        expression[:, i] = baseline + cycle + subtype_effect * 0.2 + np.random.normal(0, 0.1, n_samples)
    
    # 2D data: expression + gradient
    gradient = np.diff(expression, axis=0, prepend=expression[0:1])
    data = np.stack((expression, gradient), axis=-1)  # Shape: (n_samples, n_genes, 2)
    return data, t, subtype_labels

# Kyber: Parallel processing
def kyber_parallel(data, t, fs=1, n_cores=mp.cpu_count()):
    def process_torque(d):
        centroids, _ = kmeans(d.reshape(d.shape[0], -1), 3)
        labels, _ = vq(d.reshape(d.shape[0], -1), centroids)
        torque_score = np.var(labels)
        return labels, torque_score
    
    def process_perez(d):
        N = d.shape[0]
        yf = fft(d[:, 0, 0])  # FFT on first gene’s expression
        xf = fftfreq(N, 1/fs)[:N//2]
        dominant_freq = xf[np.argmax(np.abs(yf[:N//2]))]
        proj_factor = get_proj_factor()
        projected = proj_factor * d
        return dominant_freq, projected, proj_factor
    
    chunk_size = len(data) // n_cores
    chunks = [data[i:i+chunk_size] for i in range(0, len(data), chunk_size)]
    
    with mp.Pool(n_cores) as pool:
        torque_results = pool.map(process_torque, chunks)
        perez_results = pool.map(process_perez, chunks)
    
    all_labels = np.concatenate([lbl for lbl, _ in torque_results])
    avg_torque = np.mean([t for _, t in torque_results])
    freqs = [f for f, _, _ in perez_results]
    dominant_freq = np.mean(freqs)
    projected_data = np.mean([p for _, p, _ in perez_results], axis=0)
    
    print(f"Kyber: Dominant freq {dominant_freq:.3f} cycles/sample, Torque {avg_torque:.3f}")
    return all_labels, projected_data, dominant_freq

# NSA/MoBA: Hierarchical attention
def nsamba_refine(data, labels, projected, dominant_freq, top_k=0.2):
    n_samples, n_genes, _ = data.shape
    # Variance across genes
    variance = np.var(data[:, :, 0], axis=0)
    thresh = np.percentile(variance, 100 * (1 - top_k))
    sparse_mask = variance > thresh
    sparse_data = projected[:, sparse_mask]
    sparse_labels = labels
    
    block_sizes = [100, 500, 1000]  # Gene blocks
    attention_weights = np.zeros((sparse_data.shape[1], len(block_sizes)))
    
    freq_weight = np.clip(dominant_freq, 0.01, 0.1)
    for i, block_size in enumerate(block_sizes):
        n_blocks = max(1, sparse_data.shape[1] // block_size)
        block_var = []
        for j in range(n_blocks):
            start = j * block_size
            end = min((j+1) * block_size, sparse_data.shape[1])
            block = sparse_data[:, start:end, 0]
            block_var.append(np.var(block) if block.size > 0 else 0)
        
        block_var = np.array(block_var)
        block_weights = np.exp(block_var / (np.max(block_var + 1e-10) * freq_weight))
        block_weights /= block_weights.sum() + 1e-10
        
        for j in range(n_blocks):
            start = j * block_size
            end = min((j+1) * block_size, sparse_data.shape[1])
            attention_weights[start:end, i] = block_weights[j] / (end - start)
    
    scale_weights = np.array([1.0, 0.7, 0.3]) / np.sum([1.0, 0.7, 0.3])
    mixed_attention = np.sum(attention_weights * scale_weights[np.newaxis, :], axis=1)
    mixed_attention /= mixed_attention.sum() + 1e-10
    refined_data = sparse_data[:, :, 0] * mixed_attention[np.newaxis, :]
    
    print(f"NSA/MoBA: Refined {sparse_data.shape[1]}/{n_genes} genes")
    return refined_data, sparse_labels, mixed_attention, block_sizes

# Visualization
def visualize_results(t, data, labels, projected, refined, dom_freq, proj_factor, attention_weights, block_sizes, subtype_labels):
    fig = plt.figure(figsize=(12, 12 / FIG_RATIO))
    
    # Expression Heatmap + Clusters
    ax1 = plt.subplot(2, 2, 1)
    sns.heatmap(data[:, :, 0].T[:100], cmap='viridis', ax=ax1)
    ax1.set_title('Gene Expression + Torque Clusters')
    ax1.set_xlabel('Samples')
    ax1.set_ylabel('Genes (Subset)')
    
    # Perez Projection
    ax2 = plt.subplot(2, 2, 2)
    plt.scatter(data[:, 0, 0], data[:, 0, 1], c='blue', alpha=0.6, label='Original')
    plt.scatter(projected[:, 0, 0], projected[:, 0, 1], c='orange', alpha=0.6, label='Projected')
    plt.title(f'Perez Projection (Cycle: {1/dom_freq:.1f} samples)')
    plt.xlabel('Expression')
    plt.ylabel('Gradient')
    plt.legend()
    
    # Expression Transformation
    ax3 = plt.subplot(2, 2, 3)
    plt.plot(t, data[:, 0, 0], label='Original Expr')
    plt.plot(t, projected[:, 0, 0], label='Projected Expr')
    plt.title('Harmonic Transformation')
    plt.xlabel('Sample')
    plt.ylabel('Expression')
    plt.legend()
    
    # MoBA Attention Heatmap
    ax4 = plt.subplot(2, 2, 4)
    heatmap_data = np.zeros((len(attention_weights), len(block_sizes)))
    for i in range(len(block_sizes)):
        heatmap_data[:, i] = attention_weights[:, i]
    sns.heatmap(heatmap_data.T, cmap='viridis', cbar_kws={'label': 'Attention'}, ax=ax4)
    ax4.set_yticklabels([f'{s} genes' for s in block_sizes], rotation=0)
    ax4.set_title('MoBA: Hierarchical Attention')
    
    plt.tight_layout()
    plt.savefig('kaleidokeykai_cancer_genomics.png', dpi=300, bbox_inches='tight')
    plt.close()

# Main
if __name__ == '__main__':
    print("=== KaleidoKeyKai: Cancer Genomics (TCGA-BRCA-like) ===\nPhilosophy: Knowledge is an Arrow → CORE of the Mandala is its Target")
    
    # Generate data
    data, t, subtype_labels = generate_cancer_data()
    
    # QUIC Ingest
    data, t, latency = quic_ingest(data, t)
    
    # Kyber Parallel
    labels, projected, dom_freq = kyber_parallel(data, t)
    
    # NSA/MoBA Refine
    refined, r_labels, attention, block_sizes = nsamba_refine(data, labels, projected, dom_freq)
    
    # Visualize
    visualize_results(t, data, labels, projected, refined, dom_freq, get_proj_factor(), attention, block_sizes, subtype_labels)
    
    print("\nTest complete! PNG saved. Metrics reported.")

