    sparse_mask = variances > thresh

    n_blocks = max(1, n // block_size)
    global_attn = np.ones(n) / n
    local_attn = np.zeros(n)

    for i in range(n_blocks):
        s, e = i * block_size, min((i + 1) * block_size, n)
        local_attn[s:e] = 1 / (e - s)

    mixed_attn = 0.5 * (global_attn + local_attn)
    refined = projected * mixed_attn[:, np.newaxis]
    refined_labels = labels[sparse_mask]

    print(f"NSA/MoBA: Attention applied → Focused on {np.sum(sparse_mask)} / {n} points.")
    return refined[sparse_mask], refined_labels


# ==========================
