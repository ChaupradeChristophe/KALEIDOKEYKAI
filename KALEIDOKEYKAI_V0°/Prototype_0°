    plt.xlabel('Time (s)')
    plt.ylabel('Voltage (mV)')
    plt.legend()
    
    # Perez Projection
    ax2 = plt.subplot(2, 2, 2)
    plt.scatter(original[:, 0], original[:, 1], c='blue', alpha=0.6, label='Original (Signal vs. Derivative)')
    plt.scatter(projected[:, 0], projected[:, 1], c='orange', alpha=0.6, label='Pérez Projected')
    plt.axhline(0, color='gray', linestyle='--', alpha=0.3)
    plt.axvline(0, color='gray', linestyle='--', alpha=0.3)
    plt.title(f'Perez Projection (factor={proj_factor:.3f})\nHeart Rate: {dominant_freq*60:.1f} bpm')
    plt.xlabel('Signal')
    plt.ylabel('Derivative')
    plt.legend()
    plt.gca().set_aspect('equal')
    
    # Signal Transformation
    ax3 = plt.subplot(2, 2, 3)
    plt.plot(t, original[:, 0], label='Original ECG')
    plt.plot(t, projected[:, 0], label='Projected ECG')
    plt.title('Harmonic Transformation')
    plt.xlabel('Time (s)')
    plt.ylabel('Voltage (mV)')
    plt.legend()
    
    # MoBA Attention Heatmap
    ax4 = plt.subplot(2, 2, 4)
    heatmap_data = np.zeros((len(attention_weights), len(block_sizes)))
    for i in range(len(block_sizes)):
        heatmap_data[:, i] = attention_weights[:, i]
    sns.heatmap(heatmap_data.T, cmap='viridis', cbar_kws={'label': 'Attention Weight'})
    ax4.set_yticklabels([f'{int(s/250*1000)}ms' for s in block_sizes], rotation=0)
    ax4.set_xlabel('Sparse Points (QRS/Anomaly Focus)')
    ax4.set_title('MoBA: Hierarchical Attention (Mandala Core)')
    
    plt.tight_layout()
    plt.savefig('kaleidokeykai_ecg_analysis.png', dpi=300, bbox_inches='tight')
    plt.close()
    print("Visualizations saved as 'kaleidokeykai_ecg_analysis.png'.")

